--========================================================
-- SELECIONAR PLAYER
--========================================================

local function selectPlayer(plr)
	if plr and plr ~= player and plr.Parent == Players then
		selectedPlayer = plr
		selectedLabel.Text = "Selecionado: " .. plr.Name
		nameBox.Text = plr.Name
	end
end

local function searchPlayer()
	local typedName = nameBox.Text

	if typedName == "" then
		selectedLabel.Text = "⚠ Digite um nome!"
		return
	end

	local found = findPlayer(typedName)

	if found then
		selectPlayer(found)
	else
		selectedPlayer = nil
		selectedLabel.Text = "Esse jogador saiu do jogo, escolha outro jogador."
	end
end

searchButton.MouseButton1Click:Connect(searchPlayer)

nameBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		searchPlayer()
	end
end)

