--========================================================

-- Mochila normal: mais perto das costas/tronco
local BACKPACK_DISTANCE = 0.9
local BACKPACK_HEIGHT = -0.3

-- Mochila 2: em cima da cabeça
local HEAD_HEIGHT = 2.5

-- Velocidade para alcançar o alvo
local FOLLOW_SPEED = 28

-- Se ficar muito longe, corrige a posição
local CORRECTION_DISTANCE = 12

--========================================================
-- PEGAR PERSONAGEM
--========================================================

local function getCharacter(plr)
	if not plr or not plr.Character then
		return nil
	end

	local character = plr.Character
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local head = character:FindFirstChild("Head")

	if root and humanoid then
		return character, root, humanoid, head
	end

	return nil
end

--========================================================
-- ENCONTRAR PLAYER
--========================================================

local function findPlayer(text)
	if not text or text == "" then
		return nil
	end

	text = string.lower(text)

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and string.lower(plr.Name) == text then
			return plr
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and string.find(string.lower(plr.Name), text, 1, true) then
			return plr
		end
	end

	return nil
end

