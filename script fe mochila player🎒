local reopenDragging = false
local reopenDragStart = nil
local reopenStartPosition = nil
local reopenDragInput = nil

local function updateReopenDrag(input)

	if not reopenDragStart
		or not reopenStartPosition then
		return
	end

	local delta =
		input.Position - reopenDragStart

	reopenButton.Position = UDim2.new(
		reopenStartPosition.X.Scale,
		reopenStartPosition.X.Offset + delta.X,

		reopenStartPosition.Y.Scale,
		reopenStartPosition.Y.Offset + delta.Y
	)
end

reopenButton.InputBegan:Connect(function(input)

	if input.UserInputType
		== Enum.UserInputType.MouseButton1

		or input.UserInputType
		== Enum.UserInputType.Touch then

		reopenDragging = true
		reopenDragStart = input.Position
		reopenStartPosition = reopenButton.Position

		input.Changed:Connect(function()

			if input.UserInputState
				== Enum.UserInputState.End then

				reopenDragging = false
				reopenDragInput = nil
			end
		end)
	end
end)

reopenButton.InputChanged:Connect(function(input)

	if input.UserInputType
		== Enum.UserInputType.MouseMovement

		or input.UserInputType
		== Enum.UserInputType.Touch then

		reopenDragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)

	if reopenDragging
		and input == reopenDragInput then

		updateReopenDrag(input)
	end
end)
