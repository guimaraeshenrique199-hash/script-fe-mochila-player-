--========================================================
-- ATUALIZAR LISTA
--========================================================

local function updatePlayerList()

	for _, child in ipairs(playerList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do

		if plr ~= player then

			local button = Instance.new("TextButton")
			button.Name = plr.Name

			button.Size = UDim2.new(1, 0, 0, 34)
			button.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
			button.BorderSizePixel = 0

			button.Text = plr.Name
			button.TextColor3 = Color3.fromRGB(255, 255, 255)
			button.TextScaled = true
			button.Font = Enum.Font.Gotham

			button.Parent = playerList

			local buttonCorner = Instance.new("UICorner")
			buttonCorner.CornerRadius = UDim.new(0, 6)
			buttonCorner.Parent = button

			button.MouseButton1Click:Connect(function()

				selectedPlayer = plr
				selectedLabel.Text = "Selecionado: " .. plr.Name

			end)

		end

	end

	task.wait()

	playerList.CanvasSize = UDim2.new(
		0,
		0,
		0,
		layout.AbsoluteContentSize.Y + 10
	)
end

--========================================================
-- PLAYERS ENTRANDO E SAINDO
--========================================================

Players.PlayerAdded:Connect(function()
	task.wait(0.5)
	updatePlayerList()
end)

Players.PlayerRemoving:Connect(function(plr)

	if selectedPlayer == plr then

		selectedPlayer = nil
		backpackMode = false

		if backpackWeld then
			backpackWeld:Destroy()
			backpackWeld = nil
		end

		selectedLabel.Text = "Jogador saiu!"
		startButton.Text = "🎒 VIRAR MOCHILA"

	end

	task.wait(0.2)
	updatePlayerList()
end)

updatePlayerList()

--========================================================
-- VIRAR MOCHILA
--========================================================

startButton.MouseButton1Click:Connect(function()

	if backpackMode then
		return
	end

	if not selectedPlayer then
		selectedLabel.Text = "⚠ Escolha um jogador!"
		return
	end

	local myCharacter, myRoot, myHumanoid =
		getCharacter(player)

	local targetCharacter, targetRoot =
		getCharacter(selectedPlayer)

	if not myCharacter or not targetCharacter then
		selectedLabel.Text = "⚠ Player não encontrado!"
		return
	end

	if backpackWeld then
		backpackWeld:Destroy()
		backpackWeld = nil
	end

	backpackMode = true

	-- Sentar
	myHumanoid.Sit = true

	--====================================================
	-- POSIÇÃO DA MOCHILA
	-- Mais para baixo e atrás do jogador
	--====================================================

	myRoot.CFrame =
		targetRoot.CFrame
		* CFrame.new(0, -0.3, 1.1)
		* CFrame.Angles(0, math.rad(180), 0)

	--====================================================
	-- PRENDER AO PLAYER
	--====================================================

	backpackWeld = Instance.new("WeldConstraint")
	backpackWeld.Name = "MochilaWeld"

	backpackWeld.Part0 = myRoot
	backpackWeld.Part1 = targetRoot

	backpackWeld.Parent = myRoot

	selectedLabel.Text = "🎒 Mochila de: " .. selectedPlayer.Name
	startButton.Text = "🎒 MOCHILA ATIVA"
end)

--========================================================
-- PARAR MOCHILA
--========================================================

stopButton.MouseButton1Click:Connect(function()

	if not backpackMode then
		return
	end

	backpackMode = false

	if backpackWeld then
		backpackWeld:Destroy()
		backpackWeld = nil
	end

	local myCharacter, myRoot, myHumanoid =
		getCharacter(player)

	if myHumanoid then
		myHumanoid.Sit = false
	end

	-- Teleportar para o lado do player escolhido
	if selectedPlayer and myRoot then

		local targetCharacter, targetRoot =
			getCharacter(selectedPlayer)

		if targetRoot then

			myRoot.CFrame =
				targetRoot.CFrame
				* CFrame.new(3, 0, 0)

		end
	end

	startButton.Text = "🎒 VIRAR MOCHILA"

	if selectedPlayer then
		selectedLabel.Text =
			"Parado ao lado de: " .. selectedPlayer.Name
	else
		selectedLabel.Text = "Mochila parada"
	end
end)

--========================================================
-- GUI ARRASTÁVEL
-- MOBILE + PC
--========================================================

local dragging = false
local dragStart = nil
local startPosition = nil
local dragInput = nil

local function updateDrag(input)

	if not dragStart or not startPosition then
		return
	end

	local delta = input.Position - dragStart

	main.Position = UDim2.new(
		startPosition.X.Scale,
		startPosition.X.Offset + delta.X,
		startPosition.Y.Scale,
		startPosition.Y.Offset + delta.Y
	)
end

title.InputBegan:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPosition = main.Position

		input.Changed:Connect(function()

			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				dragInput = nil
			end
		end)
	end
end)

title.InputChanged:Connect(function(input)

	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		dragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)

	if dragging and input == dragInput then
		updateDrag(input)
	end
end)
