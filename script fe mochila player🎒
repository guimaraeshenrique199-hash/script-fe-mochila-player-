--========================================================
-- SELECIONAR PLAYER
--========================================================

local function selectPlayer(plr)
	if plr and plr ~= player then
		selectedPlayer = plr
		selectedLabel.Text = "Selecionado: " .. plr.Name
		nameBox.Text = plr.Name
	end
end

local function searchPlayer()
	local found = findPlayer(nameBox.Text)

	if found then
		selectPlayer(found)
	else
		selectedLabel.Text = "⚠ Não encontrado!"
	end
end

searchButton.MouseButton1Click:Connect(searchPlayer)

nameBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		searchPlayer()
	end
end)

--========================================================
-- LISTA DE PLAYERS
--========================================================

local function updatePlayerList()
	for _, child in ipairs(playerList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local button = Instance.new("TextButton")
			button.Size = UDim2.new(1, -4, 0, 28)
			button.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
			button.Text = plr.Name
			button.TextColor3 = Color3.new(1, 1, 1)
			button.TextScaled = true
			button.Font = Enum.Font.Gotham
			button.Parent = playerList

			Instance.new("UICorner", button).CornerRadius = UDim.new(0, 5)

			button.MouseButton1Click:Connect(function()
				selectPlayer(plr)
			end)
		end
	end

	task.wait()

	playerList.CanvasSize = UDim2.new(
		0, 0,
		0, layout.AbsoluteContentSize.Y + 5
	)
end

Players.PlayerAdded:Connect(function()
	task.wait(0.5)
	updatePlayerList()
end)

Players.PlayerRemoving:Connect(function(plr)
	if selectedPlayer == plr then
		selectedPlayer = nil
	end

	task.wait(0.2)
	updatePlayerList()
end)

updatePlayerList()

--========================================================
-- PARAR MOCHILA
--========================================================

local function stopMochila()
	backpackMode = false

	if backpackWeld then
		backpackWeld:Destroy()
		backpackWeld = nil
	end

	local _, myRoot, myHumanoid = getCharacter(player)

	if myHumanoid then
		myHumanoid.Sit = false
	end

	if selectedPlayer and myRoot then
		local _, targetRoot = getCharacter(selectedPlayer)

		if targetRoot then
			myRoot.CFrame = targetRoot.CFrame * CFrame.new(3, 0, 0)
		end
	end

	selectedLabel.Text = "Mochila parada"
end

--========================================================
-- ATIVAR MOCHILA
--========================================================

local function activateMochila(mode)
	if backpackMode then
		stopMochila()
	end

	if not selectedPlayer and nameBox.Text ~= "" then
		local found = findPlayer(nameBox.Text)
		if found then
			selectPlayer(found)
		end
	end

	if not selectedPlayer then
		selectedLabel.Text = "⚠ Escolha um player!"
		return
	end

	local _, myRoot, myHumanoid = getCharacter(player)
	local _, targetRoot, _, targetHead = getCharacter(selectedPlayer)

	if not myRoot or not myHumanoid or not targetRoot then
		selectedLabel.Text = "⚠ Player não encontrado!"
		return
	end

	backpackMode = true
	myHumanoid.Sit = true

	if mode == "Normal" then
		myRoot.CFrame =
			targetRoot.CFrame
			* CFrame.new(0, -0.3, 1.1)
			* CFrame.Angles(0, math.rad(180), 0)
	else
		local height = targetHead and 3 or 3.5
		myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, height, 0)
	end

	backpackWeld = Instance.new("WeldConstraint")
	backpackWeld.Name = "MochilaWeld"
	backpackWeld.Part0 = myRoot
	backpackWeld.Part1 = targetRoot
	backpackWeld.Parent = myRoot

	selectedLabel.Text = "🎒 Mochila: " .. selectedPlayer.Name
end

normalButton.MouseButton1Click:Connect(function()
	activateMochila("Normal")
end)

mochila2Button.MouseButton1Click:Connect(function()
	activateMochila("Cabeça")
end)

stopButton.MouseButton1Click:Connect(stopMochila)

--========================================================
-- GUI ARRASTÁVEL
--========================================================

local dragging = false
local dragStart
local startPosition
local dragInput

local function updateDrag(input)
	if not dragStart or not startPosition then
		return
	end

	local delta = input.Position - dragStart

	main.Position = UDim2.new(
		startPosition.X.Scale,
		startPosition.X.Offset + delta.X,
		startPosition.Y.Scale,
		startPosition.Y.Offset + delta.Y
	)
end

title.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPosition = main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				dragInput = nil
			end
		end)
	end
end)

title.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input == dragInput then
		updateDrag(input)
	end
end)
