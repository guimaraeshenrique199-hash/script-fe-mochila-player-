--========================================================
-- SELECIONAR PLAYER
--========================================================

local function selectPlayer(plr)
	if not plr or plr == player then
		return
	end

	selectedPlayer = plr
	selectedLabel.Text = "Selecionado: " .. plr.Name
	nameBox.Text = plr.Name
end

--========================================================
-- PROCURAR
--========================================================

local function searchPlayer()
	local found = findPlayer(nameBox.Text)

	if found then
		selectPlayer(found)
	else
		selectedLabel.Text = "⚠ Player não encontrado!"
	end
end

searchButton.MouseButton1Click:Connect(searchPlayer)

nameBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		searchPlayer()
	end
end)

--========================================================
-- LISTA
--========================================================

local function updatePlayerList()

	for _, child in ipairs(playerList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then

			local button = Instance.new("TextButton")
			button.Size = UDim2.new(1, -4, 0, 34)
			button.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
			button.BorderSizePixel = 0
			button.Text = plr.Name
			button.TextColor3 = Color3.new(1, 1, 1)
			button.TextScaled = true
			button.Font = Enum.Font.Gotham
			button.Parent = playerList

			local buttonCorner = Instance.new("UICorner")
			buttonCorner.CornerRadius = UDim.new(0, 6)
			buttonCorner.Parent = button

			button.MouseButton1Click:Connect(function()
				selectPlayer(plr)
			end)
		end
	end

	task.wait()

	playerList.CanvasSize = UDim2.new(
		0, 0,
		0, layout.AbsoluteContentSize.Y + 8
	)
end

Players.PlayerAdded:Connect(function()
	task.wait(0.5)
	updatePlayerList()
end)

Players.PlayerRemoving:Connect(function(plr)

	if selectedPlayer == plr then

		selectedPlayer = nil
		backpackMode = false

		if backpackWeld then
			backpackWeld:Destroy()
			backpackWeld = nil
		end

		selectedLabel.Text = "Jogador saiu!"
	end

	task.wait(0.2)
	updatePlayerList()
end)

updatePlayerList()

--========================================================
-- PARAR MOCHILA
--========================================================

local function stopMochila()

	if not backpackMode then
		return
	end

	backpackMode = false

	if backpackWeld then
		backpackWeld:Destroy()
		backpackWeld = nil
	end

	local _, myRoot, myHumanoid = getCharacter(player)

	if myHumanoid then
		myHumanoid.Sit = false
	end

	if selectedPlayer and myRoot then

		local _, targetRoot = getCharacter(selectedPlayer)

		if targetRoot then
			myRoot.CFrame =
				targetRoot.CFrame * CFrame.new(3, 0, 0)
		end
	end

	selectedLabel.Text = "Mochila parada"
end

--========================================================
-- ATIVAR MOCHILA
--========================================================

local function activateMochila(mode)

	if backpackMode then
		stopMochila()
	end

	if not selectedPlayer and nameBox.Text ~= "" then
		local found = findPlayer(nameBox.Text)

		if found then
			selectPlayer(found)
		end
	end

	if not selectedPlayer then
		selectedLabel.Text = "⚠ Escolha um jogador!"
		return
	end

	local _, myRoot, myHumanoid = getCharacter(player)
	local _, targetRoot, _, targetHead = getCharacter(selectedPlayer)

	if not myRoot or not myHumanoid or not targetRoot then
		selectedLabel.Text = "⚠ Player não encontrado!"
		return
	end

	backpackMode = true
	backpackModeType = mode

	myHumanoid.Sit = true

	if mode == "Normal" then

		-- Atrás do player
		myRoot.CFrame =
			targetRoot.CFrame
			* CFrame.new(0, -0.3, 1.1)
			* CFrame.Angles(0, math.rad(180), 0)

	else

		-- Em cima da cabeça
		local height = 3.5

		if targetHead then
			height = 3
		end

		myRoot.CFrame =
			targetRoot.CFrame
			* CFrame.new(0, height, 0)

	end

	backpackWeld = Instance.new("WeldConstraint")
	backpackWeld.Name = "MochilaWeld"
	backpackWeld.Part0 = myRoot
	backpackWeld.Part1 = targetRoot
	backpackWeld.Parent = myRoot

	if mode == "Normal" then
		selectedLabel.Text =
			"🎒 Mochila normal: " .. selectedPlayer.Name
	else
		selectedLabel.Text =
			"🎒 Mochila 2: " .. selectedPlayer.Name
	end
end

