--========================================================
-- SELECIONAR PLAYER
--========================================================

local function selectPlayer(plr)
	if plr and plr ~= player then
		selectedPlayer = plr
		selectedLabel.Text = "Selecionado: " .. plr.Name
		nameBox.Text = plr.Name
	end
end

local function searchPlayer()
	local found = findPlayer(nameBox.Text)

	if found then
		selectPlayer(found)
	else
		selectedLabel.Text = "⚠ Não encontrado!"
	end
end

searchButton.MouseButton1Click:Connect(searchPlayer)

nameBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		searchPlayer()
	end
end)

--========================================================
-- LISTA DE PLAYERS
--========================================================

local function updatePlayerList()
	for _, child in ipairs(playerList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local button = Instance.new("TextButton")

			button.Size = UDim2.new(1, -4, 0, 28)
			button.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
			button.BorderSizePixel = 0
			button.Text = plr.Name
			button.TextColor3 = Color3.new(1, 1, 1)
			button.TextScaled = true
			button.Font = Enum.Font.Gotham
			button.Parent = playerList

			Instance.new("UICorner", button).CornerRadius =
				UDim.new(0, 5)

			button.MouseButton1Click:Connect(function()
				selectPlayer(plr)
			end)
		end
	end

	task.wait()

	playerList.CanvasSize = UDim2.new(
		0,
		0,
		0,
		layout.AbsoluteContentSize.Y + 5
	)
end

Players.PlayerAdded:Connect(function()
	task.wait(0.5)
	updatePlayerList()
end)

Players.PlayerRemoving:Connect(function(plr)
	if selectedPlayer == plr then
		selectedPlayer = nil

		if backpackMode then
			backpackMode = false
		end
	end

	task.wait(0.2)
	updatePlayerList()
end)

updatePlayerList()

--========================================================
-- PARAR MOCHILA
--========================================================

local function stopMochila()

	backpackMode = false

	if followConnection then
		followConnection:Disconnect()
		followConnection = nil
	end

	local _, myRoot, myHumanoid = getCharacter(player)

	if myHumanoid then
		myHumanoid.Sit = false
		myHumanoid.AutoRotate = originalAutoRotate
	end

	if myRoot then
		myRoot.AssemblyLinearVelocity = Vector3.zero
		myRoot.AssemblyAngularVelocity = Vector3.zero
	end

	if selectedPlayer and myRoot then
		local _, targetRoot = getCharacter(selectedPlayer)

		if targetRoot then
			myRoot.CFrame =
				targetRoot.CFrame
				* CFrame.new(3, 0, 0)
		end
	end

	selectedLabel.Text = "Mochila parada"
end

--========================================================
-- ATIVAR MOCHILA
--========================================================

local function activateMochila(mode)

	if backpackMode then
		stopMochila()
	end

	if not selectedPlayer and nameBox.Text ~= "" then
		local found = findPlayer(nameBox.Text)

		if found then
			selectPlayer(found)
		end
	end

	if not selectedPlayer then
		selectedLabel.Text = "⚠ Escolha um player!"
		return
	end

	local _, myRoot, myHumanoid = getCharacter(player)

	if not myRoot or not myHumanoid then
		selectedLabel.Text = "⚠ Seu personagem não encontrado!"
		return
	end

	local _, targetRoot = getCharacter(selectedPlayer)

	if not targetRoot then
		selectedLabel.Text = "⚠ Player não encontrado!"
		return
	end

	backpackMode = true

	originalAutoRotate = myHumanoid.AutoRotate

	myHumanoid.AutoRotate = false
	myHumanoid.Sit = true

	myRoot.AssemblyLinearVelocity = Vector3.zero
	myRoot.AssemblyAngularVelocity = Vector3.zero

	followConnection = RunService.Heartbeat:Connect(function(deltaTime)

		if not backpackMode then
			return
		end

		if not selectedPlayer or not selectedPlayer.Parent then
			stopMochila()
			return
		end

		local _, currentRoot, currentHumanoid =
			getCharacter(player)

		local _, targetRootNow, _, targetHeadNow =
			getCharacter(selectedPlayer)

		if not currentRoot
			or not currentHumanoid
			or not targetRootNow then
			return
		end

		currentHumanoid.Sit = true
		currentHumanoid.AutoRotate = false

		local wantedCFrame

		-- MOCHILA NORMAL
		if mode == "Normal" then

			wantedCFrame =
				targetRootNow.CFrame
				* CFrame.new(
					0,
					BACKPACK_HEIGHT,
					BACKPACK_DISTANCE
				)
				* CFrame.Angles(
					0,
					math.rad(180),
					0
				)

		-- MOCHILA 2 - CABEÇA
		elseif mode == "Cabeça" then

			if targetHeadNow then
				wantedCFrame =
					targetHeadNow.CFrame
					* CFrame.new(
						0,
						HEAD_HEIGHT,
						0
					)
			else
				wantedCFrame =
					targetRootNow.CFrame
					* CFrame.new(
						0,
						4,
						0
					)
			end
		end

		if not wantedCFrame then
			return
		end

		local distance =
			(currentRoot.Position - wantedCFrame.Position).Magnitude

		--================================================
		-- CORREÇÃO AUTOMÁTICA
		--================================================

		if distance > CORRECTION_DISTANCE then

			currentRoot.CFrame = wantedCFrame

			currentRoot.AssemblyLinearVelocity = Vector3.zero
			currentRoot.AssemblyAngularVelocity = Vector3.zero

			return
		end

		--================================================
		-- SEGUIR O PLAYER
		--================================================

		if distance > 0.08 then

			local direction =
				wantedCFrame.Position
				- currentRoot.Position

			local moveDistance = math.min(
				FOLLOW_SPEED * deltaTime,
				distance
			)

			local newPosition =
				currentRoot.Position
				+ direction.Unit * moveDistance

			local rotationOnly =
				wantedCFrame
				- wantedCFrame.Position

			currentRoot.CFrame =
				CFrame.new(newPosition)
				* rotationOnly

		else

			-- Já chegou à posição da mochila
			currentRoot.CFrame = wantedCFrame
		end

		-- Remove movimentos físicos que podem causar quique
		currentRoot.AssemblyLinearVelocity = Vector3.zero
		currentRoot.AssemblyAngularVelocity = Vector3.zero
	end)

	if mode == "Normal" then
		selectedLabel.Text =
			"🎒 Seguindo: " .. selectedPlayer.Name
	else
		selectedLabel.Text =
			"🎒 Mochila 2: " .. selectedPlayer.Name
	end
end

