--========================================================
-- PARAR MOCHILA
--========================================================

local function stopMochila()

	backpackMode = false
	currentMode = nil

	if followConnection then
		followConnection:Disconnect()
		followConnection = nil
	end

	local _, myRoot, myHumanoid =
		getCharacter(player)

	if myHumanoid then
		myHumanoid.Sit = false
		myHumanoid.AutoRotate = originalAutoRotate
	end

	if myRoot then
		myRoot.AssemblyLinearVelocity = Vector3.zero
		myRoot.AssemblyAngularVelocity = Vector3.zero
	end

	if selectedPlayer and myRoot then

		local _, targetRoot =
			getCharacter(selectedPlayer)

		if targetRoot then
			myRoot.CFrame =
				targetRoot.CFrame
				* CFrame.new(3, 0, 0)
		end
	end

	selectedLabel.Text = "Mochila parada"
end

--========================================================
-- ATIVAR MOCHILA
--========================================================

local function activateMochila(mode)

	if backpackMode then
		stopMochila()
	end

	if not selectedPlayer and nameBox.Text ~= "" then

		local found = findPlayer(nameBox.Text)

		if found then
			selectPlayer(found)
		end
	end

	if not selectedPlayer then
		selectedLabel.Text =
			"Esse jogador saiu do jogo, escolha outro jogador."
		return
	end

	if selectedPlayer.Parent ~= Players then
		selectedPlayer = nil

		selectedLabel.Text =
			"Esse jogador saiu do jogo, escolha outro jogador."

		return
	end

	local _, myRoot, myHumanoid =
		getCharacter(player)

	if not myRoot or not myHumanoid then

		selectedLabel.Text =
			"⚠ Seu personagem não foi encontrado!"

		return
	end

	local _, targetRoot, targetHumanoid, targetHead =
		getCharacter(selectedPlayer)

	--====================================================
	-- PLAYER MORTO
	--====================================================

	if not targetRoot or not targetHumanoid then

		selectedLabel.Text =
			"Esse jogador morreu, espere um pouco para ele renascer e tente a mochila novamente."

		return
	end

	--====================================================
	-- ATIVA
	--====================================================

	backpackMode = true
	currentMode = mode

	originalAutoRotate = myHumanoid.AutoRotate

	myHumanoid.AutoRotate = false
	myHumanoid.Sit = true

	myRoot.AssemblyLinearVelocity = Vector3.zero
	myRoot.AssemblyAngularVelocity = Vector3.zero

	--====================================================
	-- FOLLOW
	--====================================================

	followConnection = RunService.Heartbeat:Connect(function(deltaTime)

		if not backpackMode then
			return
		end

		-- Player saiu
		if not selectedPlayer
			or selectedPlayer.Parent ~= Players then

			backpackMode = false

			if followConnection then
				followConnection:Disconnect()
				followConnection = nil
			end

			local _, root, humanoid =
				getCharacter(player)

			if humanoid then
				humanoid.Sit = false
				humanoid.AutoRotate = originalAutoRotate
			end

			if root then
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
			end

			selectedPlayer = nil

			selectedLabel.Text =
				"Esse jogador saiu do jogo, escolha outro jogador."

			return
		end

		local _, currentRoot, currentHumanoid =
			getCharacter(player)

		local _, targetRootNow, targetHumanoidNow, targetHeadNow =
			getCharacter(selectedPlayer)

		--================================================
		-- PLAYER MORREU
		--================================================

		if not targetRootNow or not targetHumanoidNow then

			backpackMode = false

			if followConnection then
				followConnection:Disconnect()
				followConnection = nil
			end

			if currentHumanoid then
				currentHumanoid.Sit = false
				currentHumanoid.AutoRotate = originalAutoRotate
			end

			if currentRoot then
				currentRoot.AssemblyLinearVelocity = Vector3.zero
				currentRoot.AssemblyAngularVelocity = Vector3.zero
			end

			selectedLabel.Text =
				"Esse jogador morreu, espere um pouco para ele renascer e tente a mochila novamente."

			return
		end

		if not currentRoot
			or not currentHumanoid
			or not targetRootNow then
			return
		end

		currentHumanoid.Sit = true
		currentHumanoid.AutoRotate = false

		local wantedCFrame

		--================================================
		-- MOCHILA NORMAL
		--================================================

		if mode == "Normal" then

			wantedCFrame =
				targetRootNow.CFrame
				* CFrame.new(
					0,
					BACKPACK_HEIGHT,
					BACKPACK_DISTANCE
				)
				* CFrame.Angles(
					0,
					math.rad(180),
					0
				)

		--================================================
		-- MOCHILA 2 - CABEÇA
		--================================================

		elseif mode == "Cabeça" then

			if targetHeadNow then

				wantedCFrame =
					targetHeadNow.CFrame
					* CFrame.new(
						0,
						HEAD_HEIGHT,
						0
					)

			else

				wantedCFrame =
					targetRootNow.CFrame
					* CFrame.new(
						0,
						4,
						0
					)
			end
		end

		if not wantedCFrame then
			return
		end

		--================================================
		-- DISTÂNCIA
		--================================================

		local distance =
			(currentRoot.Position -
				wantedCFrame.Position).Magnitude

		--================================================
		-- SE FICOU MUITO LONGE
		--================================================

		if distance > CORRECTION_DISTANCE then

			currentRoot.CFrame = wantedCFrame

			currentRoot.AssemblyLinearVelocity =
				Vector3.zero

			currentRoot.AssemblyAngularVelocity =
				Vector3.zero

			return
		end

		--================================================
		-- SEGUIR
		--================================================

		if distance > 0.08 then

			local direction =
				wantedCFrame.Position -
				currentRoot.Position

			local moveDistance =
				math.min(
					FOLLOW_SPEED * deltaTime,
					distance
				)

			local newPosition =
				currentRoot.Position +
				direction.Unit * moveDistance

			local rotationOnly =
				wantedCFrame -
				wantedCFrame.Position

			currentRoot.CFrame =
				CFrame.new(newPosition) *
				rotationOnly

		else

			currentRoot.CFrame =
				wantedCFrame
		end

		--================================================
		-- EVITA QUICAR
		--================================================

		currentRoot.AssemblyLinearVelocity =
			Vector3.zero

		currentRoot.AssemblyAngularVelocity =
			Vector3.zero

	end)

	--====================================================
	-- NOTIFICAÇÃO DE SUCESSO
	--====================================================

	if mode == "Normal" then

		selectedLabel.Text =
			"🎒 Você virou a mochila de " ..
			selectedPlayer.Name

	else

		selectedLabel.Text =
			"🎒 Você virou a mochila de " ..
			selectedPlayer.Name
	end
end

